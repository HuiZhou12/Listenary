{
  "kind": "http",
  "request": {
    "verb": "get",
    "path": "/personalized/newsong",
    "query": [
      {
        "name": "limit",
        "source": "limit",
        "required": false
      },
      {
        "name": "offset",
        "source": "offset",
        "required": false
      }
    ],
    "headers": [],
    "auth": {
      "kind": "none"
    }
  },
  "response": {
    "success": {
      "statusCodes": [],
      "allOf": [
        {
          "path": "code",
          "op": "eq",
          "value": 200
        }
      ]
    },
    "listPath": "result",
    "fields": {
      "trackId": {
        "paths": [
          "song.id"
        ],
        "transform": "asInt",
        "required": true
      },
      "title": {
        "paths": [
          "song.name"
        ],
        "transform": "asString",
        "required": true
      },
      "artists": {
        "paths": [
          "song.artists[*].name"
        ],
        "transform": "asStringList",
        "required": false
      },
      "album": {
        "paths": [
          "song.album.name"
        ],
        "transform": "asString",
        "required": false
      },
      "coverUri": {
        "paths": [
          "song.album.picUrl"
        ],
        "transform": "asHttpsUri",
        "required": false
      },
      "duration": {
        "paths": [
          "song.duration"
        ],
        "transform": "asDurationMs",
        "required": false
      }
    },
    "pagination": {
      "kind": "none",
      "defaultLimit": 30
    }
  }
}
